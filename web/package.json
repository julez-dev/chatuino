    "clsx": "^2.1.1",
    "solid-js": "^1.9.11",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.10"
  }
